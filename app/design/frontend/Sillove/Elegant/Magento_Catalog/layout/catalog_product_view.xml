<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <container name="product.other.info" htmlClass="product-other-info" htmlTag="div" after="-">
                <block class="Magento\Cms\Block\Block" name="product-other-info">
                    <arguments>
                        <argument name="block_id" xsi:type="string">product-other-info</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>
        
        <move element="product.info.overview" destination="product.info.main" after="page.main.title"/>
        <!-- <move element="product.info.extrahint" destination="product.info.form.content" after="-" /> -->
        <move element="product.info.type" destination="page.main.title" after="-"/>
        <!-- <move element="product.info.extrahint" destination="product.info.addtocart.additional" after="-"/> -->
        <move element="product.info.social" destination="product.info.addtocart.additional" before="product.info.extrahint"/>

        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceBlock name="product.info.sku" remove="true"/>
        <referenceBlock name="related.product.addto.compare" remove="true"/>
        <referenceBlock name="view.addto.compare" remove="true"/>
    </body>
</page>