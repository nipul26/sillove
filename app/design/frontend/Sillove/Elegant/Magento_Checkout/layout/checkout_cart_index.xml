<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceBlock name="checkout.cart.summary.title">
            <arguments>
                <argument translate="true" name="text" xsi:type="string">
                    Order Summary
                </argument>
            </arguments>
        </referenceBlock>

        <referenceContainer name="cart.summary">
            <block class="Magento\Cms\Block\Block"
                   name="cart.summary.digital.payments"
                   after="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">digital-payments</argument>
                </arguments>
            </block>
        </referenceContainer>

    </body>
</page>
