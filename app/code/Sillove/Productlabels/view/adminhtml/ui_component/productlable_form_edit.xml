                        <item name="component" xsi:type="string" translate="true">Magento_Ui/js/dynamic-rows/record</item>
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="discount_number">
                    <argument name="data" xsi:type="array">
                        <item name="options" xsi:type="object">Sillove\Productlabels\Model\DiscountNumbers</item>
                        <item name="config" xsi:type="array">
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="label" xsi:type="string" translate="true">Discount</item>
                            <item name="formElement" xsi:type="string">select</item>
                            <item name="source" xsi:type="string">discount_number</item>
                            <item name="dataScope" xsi:type="string">discount_number</item>
                            <item name="sortOrder" xsi:type="string">100</item>
                        </item>
                    </argument>
                </field>
                <field name="discount_text_colore">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/color-select</item>
                            <item name="template" xsi:type="string">ui/form/field</item>
                            <item name="elementTmpl" xsi:type="string">Sillove_Productlabels/form/element/color-select</item>
                            <item name="label" xsi:type="string">Text Color</item>
                            <item name="labelVisible" xsi:type="boolean">true</item>
                            <item name="visible" xsi:type="boolean">true</item>
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="sortOrder" xsi:type="string">110</item>
                            <item name="formElement" xsi:type="string">input</item>
                            <item name="source" xsi:type="string">discount_text_colore</item>
                            <item name="validation" xsi:type="array">
                                <item name="required-entry" xsi:type="boolean">true</item>
                                <item name="validate-alphanum" xsi:type="boolean">true</item>
                            </item>
                        </item>
                    </argument>
                </field>
                <field name="discount_back_colore">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/color-select</item>
                            <item name="template" xsi:type="string">ui/form/field</item>
                            <item name="elementTmpl" xsi:type="string">Sillove_Productlabels/form/element/color-select</item>
                            <item name="label" xsi:type="string">Background Color</item>
                            <item name="labelVisible" xsi:type="boolean">true</item>
                            <item name="visible" xsi:type="boolean">true</item>
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="sortOrder" xsi:type="string">120</item>
                            <item name="formElement" xsi:type="string">input</item>
                            <item name="source" xsi:type="string">discount_back_colore</item>
                            <item name="validation" xsi:type="array">
                                <item name="required-entry" xsi:type="boolean">true</item>
                                <item name="validate-alphanum" xsi:type="boolean">true</item>
                            </item>
                        </item>
                    </argument>
                </field>
                <actionDelete>
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="componentType" xsi:type="string">actionDelete</item>
                            <item name="dataType" xsi:type="string">text</item>
                            <item name="fit" xsi:type="boolean">false</item>
