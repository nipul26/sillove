        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">productlable_form_edit</item>
        </item>
        <item name="spinner" xsi:type="string">general_information</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Sillove\Productlabels\Block\Adminhtml\ProductLabel\Edit\Button\Back</item>
            <item name="delete" xsi:type="string">Sillove\Productlabels\Block\Adminhtml\ProductLabel\Edit\Button\Delete</item>
            <item name="reset" xsi:type="string">Sillove\Productlabels\Block\Adminhtml\ProductLabel\Edit\Button\Reset</item>
            <item name="save" xsi:type="string">Sillove\Productlabels\Block\Adminhtml\ProductLabel\Edit\Button\Edit</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="productlable_form_edit_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Sillove\Productlabels\Model\DataProvider</argument>
            <argument name="name" xsi:type="string">productlable_form_edit_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">label_id</argument>
            <argument name="requestFieldName" xsi:type="string">label_id</argument>
            <argument name="data" xsi:type="array">
              <item name="config" xsi:type="array">
                 <item name="submit_url" xsi:type="url" path="*/*/save"/>
              </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="rule_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Rule Information</item>
                <item name="sortOrder" xsi:type="number">10</item>
            </item>
        </argument>
        <field name="rule_status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                    <item name="label" xsi:type="string" translate="true">Active</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="number">1</item>
                        <item name="false" xsi:type="number">0</item>
                    </item>
                    <item name="valuesForOptions" xsi:type="array">
                        <item name="boolean" xsi:type="string">boolean</item>
                    </item>
                    <item name="default" xsi:type="number">1</item>
                    <item name="dataScope" xsi:type="string">rule_status</item>
                </item>
            </argument>
        </field>
        <field name="rule_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Rule Name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">rule_name</item>
                    <item name="dataScope" xsi:type="string">rule_name</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="rule_type">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\RuleTypes</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/rule-type-edit</item>
                    <item name="label" xsi:type="string" translate="true">Rule Type</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">rule_type</item>
                    <item name="dataScope" xsi:type="string">rule_type</item>
                </item>
            </argument>
        </field>
        <field name="display_in">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\DisplayType</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">int</item>
                    <item name="label" xsi:type="string" translate="true">Display In</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="source" xsi:type="string">display_in</item>
                    <item name="dataScope" xsi:type="string">display_in</item>
                    <item name="size" xsi:type="number">2</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="customer_group">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Customer\Model\Customer\Source\Group</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">int</item>
                    <item name="label" xsi:type="string" translate="true">Customer Group</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="source" xsi:type="string">customer_group</item>
                    <item name="dataScope" xsi:type="string">customer_group</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="storeviews">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Cms\Ui\Component\Listing\Column\Cms\Options</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">int</item>
                    <item name="label" xsi:type="string" translate="true">Store View</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="source" xsi:type="string">storeviews</item>
                    <item name="dataScope" xsi:type="string">storeviews</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="rule_priority">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Priority</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">rule_priority</item>
                    <item name="dataScope" xsi:type="string">rule_priority</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-number" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
    <fieldset name="label_setting">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Label Settings</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
        <field name="label_position">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\LabelPosition</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Position</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">label_position</item>
                    <item name="dataScope" xsi:type="string">label_position</item>
                </item>
            </argument>
        </field>
        <field name="label_type">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\LabelType</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/label-type-edit</item>
                    <item name="label" xsi:type="string" translate="true">Label Type</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">label_type</item>
                    <item name="dataScope" xsi:type="string">label_type</item>
                </item>
            </argument>
        </field>
        <field name="label_img">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">label_img</item>
                    <item name="label" xsi:type="string" translate="true">Upload Image</item>
                    <item name="allowedExtensions" xsi:type="string">jpg jpeg png</item>
                    <item name="maxFileSize" xsi:type="number">2097152</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="previewTmpl" xsi:type="string">Sillove_Productlabels/image-preview</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/uploader</item>
                    <item name="dataScope" xsi:type="string">label_img</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="productlable/index/upload" >
                            <param name="target_element_id">label_img</param>
                            <param name="type">image</param>
                        </item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="label_text">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Label Name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">label_text</item>
                    <item name="dataScope" xsi:type="string">label_text</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="label_color">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/color-select</item>
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="elementTmpl" xsi:type="string">Sillove_Productlabels/form/element/color-select</item>
                    <item name="label" xsi:type="string">Label Color</item>
                    <item name="labelVisible" xsi:type="boolean">true</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">label_color</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-alphanum" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="label_back_color">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/color-select</item>
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="elementTmpl" xsi:type="string">Sillove_Productlabels/form/element/color-select</item>
                    <item name="label" xsi:type="string">Label Background Color</item>
                    <item name="labelVisible" xsi:type="boolean">true</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">label_back_color</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-alphanum" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="label_shape">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\ShapeList</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Shape</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Sillove_Productlabels/js/form/element/shape</item>
                    <item name="elementTmpl" xsi:type="string">Sillove_Productlabels/form/element/select</item>
                    <item name="source" xsi:type="string">label_shape</item>
                    <item name="dataScope" xsi:type="string">label_shape</item>
                </item>
            </argument>
        </field>
        <field name="label_fontsize">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Sillove\Productlabels\Model\FontsizeList</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Label Font Size</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">label_fontsize</item>
                    <item name="dataScope" xsi:type="string">label_fontsize</item>
                </item>
            </argument>
        </field>
        <field name="label_height">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Height</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">label_height</item>
                    <item name="dataScope" xsi:type="string">label_height</item>
                    <item name="notice" xsi:type="string" translate="true"><![CDATA[Please enter value in pixel]]></item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-number" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="label_width">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Width</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">label_width</item>
                    <item name="dataScope" xsi:type="string">label_width</item>
                    <item name="notice" xsi:type="string" translate="true"><![CDATA[Please enter value in pixel]]></item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                        <item name="validate-number" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <container name="discount_row">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/dynamic-rows/dynamic-rows</item>
                    <item name="template" xsi:type="string">Sillove_Productlabels/dynamic-rows/grid</item>
                    <item name="componentType" xsi:type="string">dynamicRows</item>
                    <item name="recordTemplate" xsi:type="string">record</item>
                    <item name="deleteButtonLabel" xsi:type="string">Remove</item>
                    <item name="addButtonLabel" xsi:type="string">Add Discount</item>
                    <item name="deleteProperty" xsi:type="boolean">false</item>
                    <item name="columnsHeader" xsi:type="boolean">true</item>
                    <item name="dndConfig" xsi:type="array">
                        <item name="enabled" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
            <container name="record">
                <argument name="data" xsi:type="array">
