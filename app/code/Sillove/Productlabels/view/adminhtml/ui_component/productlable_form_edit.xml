            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Sillove\Productlabels\Block\Adminhtml\ProductLabel\Catalog\ConditionField\Conditions</argument>
            </htmlContent>
        </container>
    </fieldset>
</form>