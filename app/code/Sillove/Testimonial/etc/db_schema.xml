<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sillove_testimonial" resource="default" engine="innodb" comment="Sillove Testimonial">
        <column xsi:type="int" name="testimonial_id" nullable="false" identity="true" unsigned="true" comment="Testimonial ID" />
        <column xsi:type="int" name="customer_id" nullable="true" unsigned="true" comment="Customer ID" />
        <column xsi:type="text" name="name" nullable="false" comment="Name" />
        <column xsi:type="text" name="designation" nullable="true" comment="Designation" />
        <column xsi:type="text" name="text" nullable="true" comment="Testimonial Text" />
        <column xsi:type="smallint" name="rating_summary" nullable="false" default="5" comment="Rating Summary" />
        <column xsi:type="text" name="stores" nullable="true"  comment="Stores" />
        <column xsi:type="smallint" name="order" nullable="true"  comment="SortOrder" />
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <column xsi:type="timestamp" name="created_time" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="testimonial_id"/>
        </constraint>
        <index referenceId="TESTIMONIAL_ID_IDX">
            <column name="testimonial_id"/>
        </index>
    </table>
</schema>
