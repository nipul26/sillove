                                        <span>
                                            <?= $escaper->escapeHtml(ceil($testimonial->getRatingSummary() * 20)) ?>%
                                        </span>
                                    </span>
                                    </div>
                                    <div class="tagline">
                                        <?= $escaper->escapeHtml(__('Trusted by Millions of customers'))?>
                                    </div>
                                    <div class="rating-count">
                                       <?= $escaper->escapeHtml($testimonial->getRatingSummary().'.00') ?>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="testimonial-text">
                            <div class="testimonial-caption center-mode">
                                <?= $escaper->escapeHtml($testimonial->getText()); ?>
                            </div>
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        <div class="slider-arrow-container"></div>
        <div class="slider-dot-container"></div>
