<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
   <update handle="customer_account"/>
   <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="title" xsi:type="string">Submit Your Testimonial</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="testimonial.form"
                   template="Sillove_Testimonial::form.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Sillove\Testimonial\ViewModel\CustomerStatus</argument>
                </arguments>
            </block>
        </referenceContainer>
   </body>
</page>


