<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\Api\AccountManagementInterface">
        <plugin name="sillove_mobileotp_account_management" type="Sillove\MobileOtp\Plugin\Customer\AccountManagementPlugin"/>
    </type>
    <type name="Magento\Customer\Model\Url">
        <plugin name="sillove_mobileotp_login_url" type="Sillove\MobileOtp\Plugin\Customer\LoginUrlPlugin"/>
    </type>
    <type name="Sillove\MobileOtp\Controller\Account\Login">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="Sillove\MobileOtp\Controller\Ajax\Register">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="Sillove\MobileOtp\Controller\Ajax\Verify">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="Sillove\MobileOtp\Observer\CustomerRegisterSuccess">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="Sillove\MobileOtp\Plugin\Customer\AccountManagementPlugin">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
</config>
