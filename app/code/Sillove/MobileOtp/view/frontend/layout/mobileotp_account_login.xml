<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Sign In</title>
        <css src="Sillove_MobileOtp::css/mobile-login.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="customer.login.mobile.otp"
                   template="Sillove_MobileOtp::mobile_login.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Sillove\MobileOtp\ViewModel\OtpLogin</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
