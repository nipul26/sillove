<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <milople_webpimages>
            <extensions>
                <vector>
                    <svg>svg</svg>
                    <svg_xml>svg+xml</svg_xml>
                </vector>
                <web_image>
                    <webp>webp</webp>
                </web_image>
            </extensions>
        </milople_webpimages>
        <dev>
            <image>
                <adapters>
                    <GD2>
                        <class>Milople\WebpImages\Model\Image\Adapter\Gd2Rewrite</class>
                    </GD2>
                </adapters>
            </image>
        </dev>
    </default>
</config>
