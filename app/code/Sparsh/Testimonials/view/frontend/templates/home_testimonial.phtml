                    "<img src='<?= $block->escapeUrl($block->getViewFileUrl('Sparsh_Testimonials::images/right-arrow.png')) ?>'>"],
                    autoplay:false,
                    responsive: {
                        320: {
                            items: 1,
                            nav:false
                        },
                        599: {
                            items: 2
                        },
                        991: {
                            items: 3
                        },
                        1280: {
                            items: 3
                        }
                    }
                });
            });
        </script>
    <?php } else { ?>
        <div class="sparsh-testimonials-block">
            <div class="sparsh-testimonial-buttons">
                <h1><?= $block->escapeHtml(__('Testimonials')); ?></h1>
            </div>
