                                <?php for ($i = 1; $i <= 5; $i++): ?>
                                    <span class="star <?= $i <= $rating ? 'filled' : 'empty' ?>">&#9733;</span>
                                <?php endfor; ?>
                            </div>
                            <?php endif; ?>
                            <div class="sparsh-testimonials-name">
                                <span class="bold-text"><?= $block->escapeHtml($item['name']); ?></span>
                            </div>
                        </div>
                    <?php
                    endforeach;
                    ?>
                </div>
            </div>
        </div>
        <script>
            require(['jquery', 'owal'], function ($) {
                jQuery('.sparsh-testimonials-content-outer').owlCarousel({
                    loop: false,
