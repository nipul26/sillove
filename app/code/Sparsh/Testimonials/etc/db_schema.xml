<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="sparsh_testimonials" resource="default" comment="Sparsh Testimonials">
        <column xsi:type="int" name="testimonial_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Testimonial Id"/>
        <column xsi:type="text" name="message" nullable="false"  comment="Testimonial Message"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Person Name"/>
        <column xsi:type="smallint" name="rating" padding="5" unsigned="true" nullable="false" default="0" comment="Rating Stars (1-5)"/>
        <column xsi:type="datetime" name="testimonial_date" nullable="true" comment="Testimonial Creation Time"/>
        <column xsi:type="smallint" name="sort_order" padding="10" nullable="false" default="0" comment="Testimonial Sort Order"/>
		<column xsi:type="text" name="show_on_home" nullable="true"  comment="Show On Home Page"/>
        <column xsi:type="timestamp" name="creation_time" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Testimonial Creation Time"/>
        <column xsi:type="timestamp" name="update_time" default="CURRENT_TIMESTAMP" on_update="true" nullable="false" comment="Testimonial Modification Time"/>
		<column xsi:type="text" name="status" nullable="false" comment="Is Active"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="testimonial_id"/>
        </constraint>
    </table>
</schema>