<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Shiprocket\Checkout\Block\HeadContent" name="srcheckout.head.content" template="Shiprocket_Checkout::head.phtml" />            
        </referenceBlock>
        <referenceContainer name="header-wrapper">
            <referenceBlock name="navigation.sections" remove="true" />
        </referenceContainer>
        <referenceBlock name="header.container" remove="true" />  
        <referenceBlock name="footer" remove="true" />
        <referenceContainer name="menu" remove="true"/>
        <referenceContainer name="content">
            <block class="Shiprocket\Checkout\Block\Redirect" name="srcheckout.redirect" template="redirect.phtml" />
        </referenceContainer>
    </body>
</page>