<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
	<group id="default">
		<job instance="Shiprocket\Checkout\Cron\Cleanup" method="execute" name="shiporocket_checkout_cron_cleanup">
			<schedule>0 4 * * *</schedule>
		</job>
		<job instance="Shiprocket\Checkout\Cron\SyncProduct" method="execute" name="shiporocket_checkout_cron_sync_product">
			<schedule>*/5 * * * *</schedule>
		</job>
	</group>
</config>
