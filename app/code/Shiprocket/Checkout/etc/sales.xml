<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <section name="quote">
        <group name="totals">
            <item name="prepaiddiscount" instance="Shiprocket\Checkout\Model\Total\Quote\PrepaidDiscount" sort_order="400"/>
            <item name="fastrrcodcharge" instance="Shiprocket\Checkout\Model\Total\Quote\CodCharge" sort_order="150"/>
        </group>
    </section>
    <section name="order_invoice">
        <group name="totals">
            <item name="prepaiddiscount" instance="Shiprocket\Checkout\Model\Total\Invoice\PrepaidDiscount" sort_order="400"/>
            <item name="fastrrcodcharge" instance="Shiprocket\Checkout\Model\Total\Invoice\CodCharge" sort_order="150"/>
        </group>
    </section>
    <section name="order_creditmemo">
        <group name="totals">
            <item name="prepaiddiscount" instance="Shiprocket\Checkout\Model\Total\Creditmemo\PrepaidDiscount" sort_order="400"/>
            <item name="fastrrcodcharge" instance="Shiprocket\Checkout\Model\Total\Creditmemo\CodCharge" sort_order="150"/>
        </group>
    </section>
</config>