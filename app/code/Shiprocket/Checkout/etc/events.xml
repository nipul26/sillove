<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="srcheckout_product_save_after" instance="Shiprocket\Checkout\Observer\ProductSaveAfter" />
    </event>
    <event name="catalog_product_import_bunch_save_after">
        <observer name="srcheckout_product_import_save_after" instance="Shiprocket\Checkout\Observer\ProductImportAfter" />
    </event>
        <event name="catalog_product_delete_after">
        <observer name="srcheckout_product_delete_after" instance="Shiprocket\Checkout\Observer\ProductDeleteAfter"/>
    </event>
    <event name="catalog_category_save_after">
        <observer name="srcheckout_category_save_after" instance="Shiprocket\Checkout\Observer\CategorySaveAfter"/>
    </event>
    <event name="catalog_category_delete_after">
        <observer name="srcheckout_category_delete_after" instance="Shiprocket\Checkout\Observer\CategoryDeleteAfter"/>
    </event>
    <event name="cataloginventory_stock_item_save_after">
        <observer name="srcheckout_stock_save_after" instance="Shiprocket\Checkout\Observer\StockSaveAfter"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="srcheckout_sales_order_place_after" instance="Shiprocket\Checkout\Observer\OrderPlaceAfter" />
    </event>
    <event name="controller_action_predispatch">
        <observer name="srorder_success_load_observer" instance="Shiprocket\Checkout\Observer\OrderSuccessLoadObserver" />
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="srorder_quote_submit_before" instance="Shiprocket\Checkout\Observer\OrderSubmitBeforeObserver" />
    </event>
</config>