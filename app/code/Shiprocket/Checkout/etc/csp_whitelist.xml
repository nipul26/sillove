<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="sr-checkout" type="host">*.pickrr.com</value>
                <value id="sr-checkout-test" type="host">*.netlify.app</value>
                <value id="sr-checkout-in" type="host">*.shiprocket.in</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="sr-checkout" type="host">*.pickrr.com</value>
                <value id="sr-checkout-test" type="host">*.netlify.app</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="sr-checkout" type="host">*.pickrr.com</value>
                <value id="sr-checkout-test" type="host">*.netlify.app</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="sr-checkout" type="host">*.pickrr.com</value>
                <value id="sr-checkout-in" type="host">*.shiprocket.in</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="sr-checkout" type="host">*.pickrr.com</value>
                <value id="sr-checkout-test" type="host">*.netlify.app</value>
                <value id="fastrr" type="host">*.fastrr.com</value>
                <value id="sr-checkout-in" type="host">*.shiprocket.in</value>
                <value id="cred-club" type="host">https://cred.club</value>
                <value id="razorpay" type="host">*.razorpay.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>