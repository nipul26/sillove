<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/config.xsd">
    <default>
        <shiprocket_checkout>
            <general>
                <enabled>1</enabled>
                <mode>1</mode>
                <create_invoice>0</create_invoice>
                <product_discount>0</product_discount>
                <ordr_log>0</ordr_log>
                <debug_log>0</debug_log>
            </general>
            <button>
                <productpage>
                    <product>1</product>
                    <product_integration_type>1</product_integration_type>
                    <product_button_id>sr-buynow-button</product_button_id>
                    <producttxt>BUY NOW with UPI / COD</producttxt>
                </productpage>
                <cartpage>
                    <cart>1</cart>
                    <cart_integration_type>1</cart_integration_type>
                    <cart_button_id>sr-cart-buynow-button</cart_button_id>
                    <carttxt>PROCEED TO CHECKOUT</carttxt>
                </cartpage>
                <minicartpage>
                    <minicart>0</minicart>
                    <minicart_type>1</minicart_type>
                    <minicart_button_id>sr-minicart-buynow-button</minicart_button_id>
                    <minicarttxt>PROCEED TO CHECKOUT</minicarttxt>
                </minicartpage>
            </button>
            <customer>
                <guest>0</guest>
                <customerattribute>email</customerattribute>
            </customer>
        </shiprocket_checkout>
         <carriers>
            <srshipping>
                <active>1</active>
                <sallowspecific>0</sallowspecific>
                <model>Shiprocket\Checkout\Model\Carrier\ShiprocketShipping</model>
                <name>Shiprocket Shipping</name>
                <price>0.00</price>
                <title>Shiprocket Shipping Method</title>
                <specificerrmsg>This shipping method is not available. To use this shipping method, please contact us.</specificerrmsg>
                <handling_type>F</handling_type>
            </srshipping>
        </carriers>
        <payment>
            <srcheckout_prepaid>
                <active>1</active>
                <model>Shiprocket\Checkout\Model\Payment\ShiprocketPay</model>
                <order_status>pending</order_status>
                <title>SrCheckout Prepaid</title>
            </srcheckout_prepaid>
            <srcheckout_cod>
                <active>1</active>
                <model>Shiprocket\Checkout\Model\Payment\ShiprocketCod</model>
                <order_status>pending</order_status>
                <title>SrCheckout COD</title>
            </srcheckout_cod>
        </payment>
    </default>
</config>
