<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/routes.xsd">
    <route url="/V1/shiprocket/order/create" method="POST">
        <service class="Shiprocket\Checkout\Api\CreateOrderInterface" method="createOrder"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
        <data>
            <parameter name="orderData" force="true">%orderData%</parameter>
        </data>
    </route>
    <route url="/V1/shiprocket/abandoned/cart" method="POST">
        <service class="Shiprocket\Checkout\Api\AbandonedCartInterface" method="createAbandonedCart"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
        <data>
            <parameter name="cartData" force="true">%cartData%</parameter>
        </data>
    </route>
    <route url="/V1/srproduct/:sku" method="GET">
        <service class="Shiprocket\Checkout\Api\SrProductInterface" method="getProductData"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
    <route url="/V1/srorder/count/:phone" method="GET">
        <service class="Shiprocket\Checkout\Api\SrOrderCountInterface" method="getOrderCountByCustomerId"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
</routes>
